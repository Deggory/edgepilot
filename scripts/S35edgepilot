#!/bin/sh

APP_DIR="/root/edgepilot"
MANAGER="./manager.py"
PYTHON="/usr/bin/python3"
PID_FILE="/var/run/edgepilot.pid"
LOG_FILE="/tmp/edgepilot.log"

find_manager_pid() {
	for proc in /proc/[0-9]*; do
		[ -r "$proc/cmdline" ] || continue
		args="$(tr '\000' ' ' < "$proc/cmdline" 2>/dev/null)"
		case " $args " in
			*" $MANAGER "*|*" $APP_DIR/manager.py "*)
				echo "${proc##*/}"
				return 0
				;;
		esac
	done
	return 1
}

running_pid() {
	if [ -s "$PID_FILE" ]; then
		pid="$(cat "$PID_FILE" 2>/dev/null)"
		if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
			echo "$pid"
			return 0
		fi
		rm -f "$PID_FILE"
	fi
	find_manager_pid
}

start() {
	printf "Starting edgepilot: "
	if pid="$(running_pid)"; then
		echo "$pid" > "$PID_FILE"
		echo "already running (pid $pid)"
		return 0
	fi
	if [ ! -x "$APP_DIR/$MANAGER" ] || [ ! -x "$PYTHON" ]; then
		echo "FAIL (runtime not installed)"
		return 1
	fi

	export HOME="/root"
	export PYTHONUNBUFFERED="1"
	start-stop-daemon --start --background --make-pidfile \
		--pidfile "$PID_FILE" \
		--exec "$PYTHON" \
		--chdir "$APP_DIR" \
		--output "$LOG_FILE" \
		-- "$MANAGER"
	status=$?
	# Allow the display process to spawn before the Wi-Fi module starts its
	# CPU-heavy initialization.  Bound the wait so a display failure never
	# blocks the rest of boot.
	wait_count=20
	while [ -z "$(pidof overlayd 2>/dev/null)" ] && [ "$wait_count" -gt 0 ]; do
		sleep 0.1
		wait_count=$((wait_count - 1))
	done
	if [ "$status" -eq 0 ] && pid="$(running_pid)"; then
		echo "OK (pid $pid)"
		return 0
	fi
	echo "FAIL"
	return 1
}

stop() {
	printf "Stopping edgepilot: "
	if ! pid="$(running_pid)"; then
		echo "not running"
		return 0
	fi

	kill -TERM "$pid" 2>/dev/null || true
	timeout=60
	while kill -0 "$pid" 2>/dev/null && [ "$timeout" -gt 0 ]; do
		sleep 0.1
		timeout=$((timeout - 1))
	done
	if kill -0 "$pid" 2>/dev/null; then
		kill -KILL "$pid" 2>/dev/null || true
	fi
	rm -f "$PID_FILE"
	echo "OK"
}

status() {
	if pid="$(running_pid)"; then
		echo "edgepilot is running (pid $pid)"
		return 0
	fi
	echo "edgepilot is stopped"
	return 1
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart)
		stop
		start
		;;
	status)
		status
		;;
	*)
		echo "Usage: $0 {start|stop|restart|status}"
		exit 1
		;;
esac

exit $?
