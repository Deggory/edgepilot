# 카메라 내부 파라미터 측정용 캡처(docs/camcal.md). 부팅 때 켜지지 않는다.
# systemctl start camcal 하면 런타임(supercombo)이 멈추고, 끝나면
# systemctl stop camcal && systemctl start supercombo.
[Unit]
Description=Camera intrinsics capture (k230_camcal)
# Conflicts만으로는 런타임 정지와 camcal 시작이 동시에 돌아, camerad가 VI를 닫는 중에
# camcal이 VI를 열다 보드가 멈췄다. After=로 정지가 끝난 뒤 시작하게 한다.
After=rc-local.service supercombo.service launcher.service
Conflicts=supercombo.service launcher.service

[Service]
EnvironmentFile=-/etc/environment
WorkingDirectory=@DEST@
ExecStart=@DEST@/k230_camcal
KillMode=mixed
